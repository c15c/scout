# Geocoding
MAPBOX_TOKEN=pk_...

# Ingest cron security
INGEST_SECRET=your-secret-ingest-key

# Social platform APIs (optional until E7)
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
